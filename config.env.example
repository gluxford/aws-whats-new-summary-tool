# Copy this file to config.env and set your own values:
#
#   cp config.env.example config.env
#
# config.env is listed in .gitignore, so your details are never committed.
# The scripts in scripts/ load it automatically.

# Name of your local AWS CLI profile.
# See "Create a local AWS CLI profile" in README.md.
AWS_PROFILE=your-profile-name

# Region to deploy into. Amazon Nova Lite must be available in this region.
AWS_REGION=ap-southeast-2

# Address that receives the summary email. It must be verified in SES;
# scripts/deploy.sh sends the verification email for you.
RECIPIENT_EMAIL=you@example.com

# Optional. Address the email is sent from. Leave blank to use RECIPIENT_EMAIL.
# If set, it must also be verified in SES.
SENDER_EMAIL=

# Optional. When to run, as an EventBridge cron expression in UTC.
# cron(0 17 * * ? *)   = daily at 03:00 AEST (default)
# cron(0 5,17 * * ? *) = 03:00 and 15:00 AEST
SCHEDULE_EXPRESSION="cron(0 17 * * ? *)"

# Optional. Maximum RSS items checked per run, and the Bedrock model used.
MAX_ANNOUNCEMENTS=50
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
